            "url": "{{baseUrl}}/veiculos/{{veiculoUuid}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Retorna o veiculo do seed', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().uuid).to.eql(pm.environment.get('veiculoUuid'));",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Pecas - catalogo",
      "item": [
        {
          "name": "Listar pecas do catalogo",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/pecas?page=0&size=20&sort=codigo,asc&isActive=true"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Retorna pagina do catalogo sem campos de estoque', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.content).to.be.an('array');",
                  "  body.content.forEach(function (peca) {",
                  "    pm.expect(peca).not.to.have.property('saldoAtual');",
                  "    pm.expect(peca).not.to.have.property('saldoReservado');",
                  "    pm.expect(peca).not.to.have.property('estoqueMinimo');",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Buscar peca PEA-001 do seed",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/pecas/{{peca1Uuid}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Retorna PEA-001 do catalogo', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().codigo).to.eql('PEA-001');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Consultar pecas em lote (Supplies)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pecaUuids\": [\n    \"{{peca1Uuid}}\",\n    \"{{peca2Uuid}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/internal/pecas/batch"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Batch retorna ambas as pecas do seed', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.pecas).to.have.length(2);",
                  "  pm.expect(body.naoEncontradas).to.be.empty;",
                  "  pm.expect(body.pecas[0]).to.have.property('isActive');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
