{
  "info": {
    "_postman_id": "74b4439d-79fc-4ed8-b8ea-4f4aa38d20e9",
    "name": "Mekano Registry",
    "description": "Consultas seguras aos recursos de clientes, veiculos, catalogos e batch. Usa os UUIDs fixos do seed do Registry.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Clientes",
      "item": [
        {
          "name": "Listar clientes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/clientes?page=0&size=20&sort=nome,asc&isActive=true"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Retorna 200 e pagina de clientes', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.have.property('content').that.is.an('array');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Buscar cliente do seed",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/clientes/{{clienteUuid}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Retorna o cliente do seed', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().uuid).to.eql(pm.environment.get('clienteUuid'));",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Veiculos",
      "item": [
        {
          "name": "Listar veiculos do cliente do seed",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/veiculos?page=0&size=20&sort=placa,asc&clienteUuid={{clienteUuid}}&isActive=true"
